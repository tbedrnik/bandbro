{
	"name": "bandbro",
	"version": "1.0.50",
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"dev": "NODE_ENV=development bun run --watch src/backend/index.ts",
		"prod": "NODE_ENV=production bun run src/backend/index.ts",
		"auth:generate": "bunx @better-auth/cli@latest generate --config src/backend/auth.ts --output prisma/models/auth.prisma",
		"db:generate": "bun --bun run prisma generate",
		"db:create": "bun --bun run prisma migrate dev --create-only",
		"db:migrate": "bun --bun run prisma migrate deploy",
		"db:push": "bun --bun run prisma db push",
		"db:reset": "bun --bun run prisma db reset",
		"db:seed": "bun run prisma/seed.ts",
		"import:kytary": "bun run src/tools/importKytary.ts",
		"repair:markers": "bun run src/tools/repairSectionMarkers.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"@chordbook/codemirror-lang-chordpro": "^0.0.3",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/modifiers": "^9.0.0",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@elysiajs/eden": "^1.4.9",
		"@elysiajs/server-timing": "^1.4.1",
		"@elysiajs/static": "^1.4.10",
		"@fontsource-variable/space-grotesk": "^5.2.6",
		"@fontsource/ibm-plex-mono": "^5.2.6",
		"@fontsource/ibm-plex-sans": "^5.2.6",
		"@nanostores/react": "^1.1.0",
		"@prisma/adapter-libsql": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"@tabler/icons-react": "^3.44.0",
		"@tanstack/react-form": "^1.33.0",
		"@tanstack/react-query": "^5.101.2",
		"@tanstack/react-router": "^1.170.16",
		"@uiw/codemirror-themes": "^4.25.10",
		"@uiw/react-codemirror": "^4.25.10",
		"better-auth": "^1.6.22",
		"bun-plugin-tailwind": "^0.1.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"eden-tanstack-react-query": "^0.1.10",
		"elysia": "^1.4.29",
		"qrcode-generator": "^2.0.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"shadcn": "^3.8.5",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.1",
		"tw-animate-css": "^1.4.0",
		"vaul": "^1.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.1",
		"@tanstack/router-cli": "^1.167.17",
		"@types/react-dom": "^19.2.3",
		"bun-types": "latest",
		"playwright-core": "^1.61.1",
		"prisma": "^7.8.0",
		"typescript": "^5.9.3"
	},
	"module": "src/backend/index.js"
}
