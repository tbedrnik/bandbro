model Song {
	id String @id @default(cuid())
	slug String @unique
	name String
	year Int?

	// Ownership / scope: null = Curated (public read-only); otherwise the owning
	// Organization (a band, or a user's personal "one-man-band" org). See CLAUDE.md §D1.
	organizationId String?
	organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

	// Fork provenance — a fork copies the Song (+ its Chart) into a writable scope
	// but stays independent of the source. See CLAUDE.md §D3.
	forkedFromId String?
	forkedFrom   Song?    @relation("SongForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
	forks        Song[]   @relation("SongForks")

	credits Credit[]
	charts  Chart[]
	tags    SongTag[]

	// Potential future Album relation:
	// albums Album[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([organizationId])
	@@map("song")
}

model Chart {
	id          String   @id @default(cuid())

	content     String
	description String?

	// Denormalized from the ChordPro {directives} in `content` on every write, so the
	// library can sort/filter without parsing every row. `content` stays the source of
	// truth. See CLAUDE.md §D4.
	key           String?
	capo          Int?
	tempo         Int?
	timeSignature String?

	songId      String
	song        Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

	organizationId      String?
	organization        Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

	// Forking
	forkedFromId   String?
	forkedFrom     Chart?   @relation("ChartForks", fields: [forkedFromId], references: [id], onDelete: SetNull)
	forks       Chart[]  @relation("ChartForks")

	songbooks   SongbookSong[]
	suggestions Suggestion[]

	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@index([songId])
	@@index([organizationId])
	@@map("chart")
}

model Artist {
	id String @id @default(cuid())
	slug String @unique
	name String
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	credits Credit[]

	@@map("artist")
}

// Connects Artists to Songs with a specific role
model Credit {
	id String @id @default(cuid())

	songId String
	song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

	artistId String
	artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

	role CreditRole @default(ARTIST)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@unique([songId, artistId, role])
	@@map("credit")
}

enum CreditRole {
	ARTIST      // The main performing artist/band
	COMPOSER    // Wrote the music
	LYRICIST    // Wrote the lyrics
	ARRANGER    // Arranged the music
	PRODUCER    // Produced the track
}

// Free-form labels on a song (folk, slow, gospel…) used for Library filtering.
model Tag {
	id   String @id @default(cuid())
	slug String @unique
	name String

	songs SongTag[]

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@map("tag")
}

model SongTag {
	songId String
	song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)

	tagId String
	tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

	@@id([songId, tagId])
	@@index([tagId])
	@@map("song_tag")
}

model Songbook {
	id          String   @id @default(cuid())
	title       String
	description String?

	organizationId      String
	organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

	songs       SongbookSong[]
	liveSessions LiveSession[]
	pdfExports  PdfExport[]

	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@index([organizationId])
	@@map("songbook")
}

// A public, read-only "fan" session for a setlist (CLAUDE.md fan-experience handoff).
// The band shares a 5-character `code`; fans open bandbro.live/s/<code> (no auth) and
// auto-follow whichever song the band is on. The band's client is the source of truth
// for `currentSongIndex`; fan clients poll this read-only. `organizationId` is denormalized
// from the songbook for the membership guard on writes; the relation lives on Songbook so
// deleting the band cascades the songbook → its sessions.
model LiveSession {
	id   String @id @default(cuid())
	code String @unique

	songbookId String
	songbook   Songbook @relation(fields: [songbookId], references: [id], onDelete: Cascade)

	organizationId String

	currentSongIndex Int     @default(0)
	active           Boolean @default(true)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([songbookId])
	@@map("live_session")
}

model SongbookSong {
	songbookId String
	songbook   Songbook @relation(fields: [songbookId], references: [id], onDelete: Cascade)

	chartId    String
	chart      Chart    @relation(fields: [chartId], references: [id], onDelete: Cascade)

	order      Int      @default(0)

	createdAt   DateTime @default(now())
	updatedAt   DateTime @updatedAt

	@@id([songbookId, chartId])
	@@map("songbook_song")
}

// A queued setlist PDF render (CLAUDE.md §D20). Rendering shells out to `chordpro` and
// takes tens of seconds, which is longer than any HTTP connection should be asked to hold
// open — so the request only *creates* one of these and the client polls it. The table is
// the queue: a Railway volume forbids replicas, so there is exactly one app instance and
// an in-process worker draining this is the whole of the scheduler.
model PdfExport {
	id String @id @default(cuid())

	songbookId String
	songbook   Songbook @relation(fields: [songbookId], references: [id], onDelete: Cascade)

	requestedById String
	requestedBy   User   @relation(fields: [requestedById], references: [id], onDelete: Cascade)

	// One of PdfMode: "fingered" | "concert" | "both".
	mode String @default("both")

	// "pending" | "running" | "done" | "failed". `error` is player-facing on failure.
	status String  @default("pending")
	error  String?

	// Set once the render lands. The bytes live on the volume beside the database, not in
	// the row: a 60-song setlist is ~500 KB and SQLite is not where that belongs.
	filePath  String?
	filename  String?
	bytes     Int?
	songCount Int?

	createdAt  DateTime  @default(now())
	startedAt  DateTime?
	finishedAt DateTime?

	@@index([songbookId])
	@@index([status])
	@@map("pdf_export")
}

// A proposed edit to a chart the proposer can't write directly (PRD §8 J10 / should-have).
// The band's writers/admins accept (apply to the chart) or reject. See CLAUDE.md §A6.
model Suggestion {
	id              String  @id @default(cuid())
	chartId         String
	chart           Chart   @relation(fields: [chartId], references: [id], onDelete: Cascade)
	proposedContent String
	message         String?

	proposerId String
	proposer   User   @relation(fields: [proposerId], references: [id], onDelete: Cascade)

	status SuggestionStatus @default(PENDING)

	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt

	@@index([chartId])
	@@index([proposerId])
	@@map("suggestion")
}

enum SuggestionStatus {
	PENDING
	ACCEPTED
	REJECTED
}
